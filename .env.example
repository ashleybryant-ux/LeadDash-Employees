# LeadDash Employees server settings. Copy to .env on the server (never commit .env).

# Server
PORT=4100
APP_URL=https://employees.leaddash.io

# Who is LeadDash staff (support access to every workspace, can create workspaces). Comma-separated.
ADMIN_EMAILS=

# Database file and generated images (both under ./data, which is git-ignored)
DATABASE_PATH=./data/employees.db
UPLOADS_DIR=./data/uploads

# Encrypts saved connection secrets. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later makes saved connection secrets unreadable.
SECRETS_KEY=

# Writing: AssemblyAI LLM Gateway (same key as DashNotes)
ASSEMBLYAI_API_KEY=
# Cheapest captions (Whisper); healthcare practices always use AssemblyAI instead.
GROQ_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Web search for grants, speaking events, video trends and license checks.
# anthropic (default) uses ANTHROPIC_API_KEY below; openai uses OPENAI_API_KEY.
SEARCH_PROVIDER=anthropic
OPENAI_SEARCH_MODEL=gpt-6.1-sol

# Anthropic API: web search, reading scanned PDFs and photos
ANTHROPIC_API_KEY=
# Only for a personal key (sk-ant-usr-) not scoped to one workspace. Settings, Workspaces, ID column.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
SEARCH_MAX_USES=6

# Images for social posts and blog banners (and web search when SEARCH_PROVIDER=openai): OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Sign-in code emails: Amazon SES (same account and verified domain as LeadDash EHR)
SES_REGION=us-east-1
EMAIL_FROM=LeadDash Employees <noreply@leaddash.io>
EMAIL_REPLY_TO=info@leaddash.io

# Push notifications. Generate once on the server: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@leaddash.io

# SAM.gov public API key for Quinn's exclusion check (free, from your SAM.gov account settings)
SAM_API_KEY=

# Frappe HR for Quinn's job posts (optional). Publish creates a Job Opening there; its Job Applicants come back into Candidates.
# Each workspace needs a Company in Frappe HR with the workspace's exact name. API key and secret: Frappe user settings, API Access.
FRAPPE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# One-click connections. LeadDash registers one app with each company, once.
# Redirect URI for each: https://employees.leaddash.io/api/oauth/<google|google_business|linkedin|meta|x>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Recall.ai: LeadDash's own account. Avery's meeting notes for every workspace; the minutes are rebilled as usage. Workspaces are never asked for a key.
RECALL_API_KEY=
RECALL_REGION=us-west-2

# LeadDash EHR opens this app for a practice (Settings, LeadDash Employees) and sets the roster's
# portraits and voices from its agency screen. The same value goes in the EHR server's EHR_LINK_SECRET.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EHR_LINK_SECRET=

# Card payments for extra work hours (Stripe Checkout). Webhook: https://<this app>/api/stripe/webhook, event checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stock footage for Elena's videos (either or both; Pexels first, then Pixabay)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# LeadDash voices: the Kokoro speech server on this box (OpenAI-style /v1), e.g. http://127.0.0.1:8880/v1
LOCAL_TTS_URL=
# The LeadDash EHR demo's team code (demo.leaddash.io/?team=<code>). Simone's recordings open the demo through it, skipping the sign-up card.
EHR_DEMO_TEAM_CODE=
# Browser steps (which button to press next) run on this smaller model through ANTHROPIC_API_KEY when the task carries no client information. "off" keeps them on the gateway.
BROWSER_MODEL=claude-haiku-4-5
